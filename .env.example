# Database (Neon / Postgres)
# Get this from Neon Dashboard -> Project -> Dashboard -> Connection Details
DATABASE_URL=

# Global Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Clerk)
# Get from Clerk Dashboard -> API Keys -> standard keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Webhook Secret for User Syncing
# Get from Clerk Dashboard -> Webhooks -> Endpoint Secret
CLERK_SIGNING_SECRET=

# Video Processing (Mux)
# Get from Mux Dashboard -> Settings -> API Keys (Create new access token)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux Webhook Secret
# Get from Mux Dashboard -> Settings -> Webhooks -> Signing Secret
MUX_WEBHOOK_SECRET=

# AI Features (OpenAI)
# Get from OpenAI Platform -> API Keys
OPENAI_API_KEY=

# Redis & Background Workflows (Upstash)
# Get Redis credentials from Upstash Dashboard -> Redis -> Connect
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Get Workflow credentials from Upstash Dashboard -> QStash -> Workflows / Tokens
UPSTASH_WORKFLOW_URL=
QSTASH_TOKEN=

# File Uploads (Uploadthing)
# Get from Uploadthing Dashboard -> API Keys
UPLOADTHING_TOKEN=

# Development Auth Bypass (Set to true to use the local dev bypass without Clerk)
NEXT_PUBLIC_DEV_BYPASS_AUTH=true
